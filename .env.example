# ─────────────────────────────────────────────────────────────
# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不会进仓库。
# ─────────────────────────────────────────────────────────────

# 文本模型 API Key（必填）
# 任何 OpenAI 兼容服务的 key：自建网关 / OpenAI / 通义 / DeepSeek 等
WORKBUDDY_API_KEY=

# LLM 网关地址（可选）
# 不填则用 config.json 里的 llm.baseURL
# 例：http://127.0.0.1:7863/v1
LLM_BASE_URL=

# OpenViking 语义检索 key（可选；不用检索功能可留空并设 viking.enabled=false）
OPENVIKING_API_KEY=

# 规则页「保存」的写入路径（可选；不填则规则页只读）
# 例：/data/rules.json
RULES_WRITE_PATH=
