{
  "_comment": "prompt-lab NAS 版配置。与本机 DSH 插件版共享 prompt_rules.json 的族规则，但去掉 DSH 专有的 NAS/VLM 段。改这个文件重启容器生效。",
  "server": {
    "port": 33002,
    "host": "0.0.0.0"
  },
  "llm": {
    "_comment": "LLM 网关（OpenAI 兼容）。baseURL 可用环境变量 LLM_BASE_URL 覆盖；key 从环境变量读取，不要写进本文件。",
    "baseURL": "http://127.0.0.1:7863/v1",
    "apiKeyEnv": "WORKBUDDY_API_KEY",
    "defaultModel": "cn:deepseek-v4.1-flash",
    "models": [
      {
        "id": "cn:deepseek-v4.1-flash",
        "label": "DeepSeek V4.1 Flash（默认）",
        "contextWindow": 1000000,
        "maxTokens": 384000
      },
      {
        "id": "cn:kimi-k3-1",
        "label": "Kimi K3",
        "contextWindow": 256000,
        "maxTokens": 32000
      },
      {
        "id": "cn:deepseek-v4-flash",
        "label": "DeepSeek V4 Flash",
        "contextWindow": 1000000,
        "maxTokens": 32000
      },
      {
        "id": "cn:deepseek-v4-pro",
        "label": "DeepSeek V4 Pro",
        "contextWindow": 1000000,
        "maxTokens": 384000
      },
      {
        "id": "cn:glm-5.3-flash",
        "label": "GLM 5.3 Flash",
        "contextWindow": 1000000,
        "maxTokens": 131072
      },
      {
        "id": "cn:glm-5.3",
        "label": "GLM 5.3",
        "contextWindow": 1000000,
        "maxTokens": 131072
      },
      {
        "id": "cn:kimi-k2.8-preview",
        "label": "Kimi K2.8 Preview",
        "contextWindow": 256000,
        "maxTokens": 32000
      }
    ],
    "temperature": {
      "gen": 0.8,
      "refine": 0.4,
      "reverse": 0.4,
      "iterate": 0.4
    },
    "maxTokens": 4000,
    "timeoutSeconds": 180,
    "baseURLEnv": "LLM_BASE_URL"
  },
  "vlm": {
    "_comment": "反推第一优先：用多模态模型直接看图；拒答/失败才降级 WD14。",
    "enabled": true,
    "model": "",
    "_modelNote": "留空则跟随 llm.defaultModel。需选一个支持 vision 的模型。",
    "temperature": 0.3,
    "maxTokens": 1200,
    "timeoutSeconds": 120,
    "_timeoutNote": "带图请求较慢，留足 120s；超时则降级 WD14",
    "fallbackToWd14": true,
    "_fallbackNote": "VLM 拒答或失败时是否降级 WD14。关掉则反推直接失败。"
  },
  "wd14": {
    "_comment": "WD14 微服务。反推的第二通道 —— VLM 拒答 NSFW 时用它兜底。",
    "host": "http://host.docker.internal:33001",
    "_hostNote": "host.docker.internal = 宿主机（compose extra_hosts 映射为 host-gateway）。容器内不能写 127.0.0.1。",
    "threshold": 0.35,
    "charThreshold": 0.85,
    "top": 80,
    "timeoutSeconds": 120
  },
  "booru": {
    "_comment": "Danbooru 查询（公开 API）。若网络受限可填 proxy。",
    "enabled": true,
    "baseURL": "https://danbooru.donmai.us",
    "proxy": "",
    "_proxyNote": "留空直连；被墙时填 http://127.0.0.1:7890（clash 起来后）",
    "timeoutSeconds": 30,
    "maxPosts": 8,
    "userAgent": "prompt-lab-nas/1.0"
  },
  "viking": {
    "_comment": "OpenViking 语义检索（可选）。不需要就设 enabled=false。地址按自己的部署填写。",
    "apiKeyEnv": "OPENVIKING_API_KEY",
    "active": "compliance",
    "instances": [
      {
        "name": "compliance",
        "baseURL": "http://127.0.0.1:1933"
      },
      {
        "name": "nsfw",
        "baseURL": "http://127.0.0.1:1934"
      }
    ],
    "maxRefs": 5,
    "refTextChars": 800,
    "timeoutMs": 60000,
    "mode": "",
    "readLevel": "",
    "enabled": false
  },
  "camera": {
    "_comment": "相机角度映射。吸收自 ComfyUI_VNCCS_Utils，词是 Multiple-Angles LoRA 的标准写法，不要改。",
